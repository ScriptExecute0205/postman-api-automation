    {
      "name": "Create a Product",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let randomId = Math.floor(Math.random() * 100000);\r",
              "let productName = \"Test Product \" + randomId;\r",
              "console.log(productName)\r",
              "let productPrice = Math.floor(Math.random() * 1000) + 100;\r",
              "console.log(productPrice)\r",
              "\r",
              "pm.environment.set(\"productName\", productName)\r",
              "pm.environment.set(\"productPrice\", productPrice)\r",
              "\r",
              "console.log(\"Running iteration:\", pm.info.iteration);\r",
              "console.log(\"Title used:\", pm.iterationData.get(\"title\"));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "console.log(pm.environment.get(\"productName\"))\r",
              "console.log(pm.environment.get(\"productPrice\"))\r",
              "\r",
              "pm.test(\"Validate status code is 201\", ()=>\r",
              "{\r",
              "pm.response.to.have.status(201)\r",
              "})\r",
              "\r",
              "pm.test(\"Response Body is not empty\", ()=>\r",
              "{\r",
              "    pm.expect(pm.response.json()).to.not.be.empty;\r",
              "})\r",
              "\r",
              "let requestData = pm.request.body.raw;\r",
              "let requestJSON = JSON.parse(requestData)\r",
              "let responseJSON = pm.response.json();\r",
              "\r",
              "pm.test(\"Validate Request Data matches Response Data\", ()=>\r",
              "{\r",
              "pm.expect(responseJSON.title).to.eql(requestJSON.title);\r",
              "pm.expect(responseJSON.price).to.eql(requestJSON.price);\r",
              "pm.expect(responseJSON.description).to.eql(requestJSON.description);\r",
              "pm.expect(responseJSON.category).to.eql(requestJSON.category);\r",
              "})\r",
              "\r",
              "pm.environment.set(\"productID\",  responseJSON.id);\r",
              "console.log(pm.environment.get(\"productID\",  responseJSON.id))\r",
              "\r",
              "let id = pm.environment.get(\"productID\")\r",
              "console.log(\"New Product ID\", id)"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
